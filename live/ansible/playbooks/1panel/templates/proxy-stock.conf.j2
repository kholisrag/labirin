{{ ansible_managed | comment }}
# Managed by live/ansible/playbooks/1panel/manage-websites.yaml
# Rewritten in full on every run - edits made in the 1Panel dashboard are lost.
#
# 1PANEL'S STOCK REVERSE-PROXY BLOCK, REPRODUCED VERBATIM. Every other template
# here exists because the stock block breaks something; this one is for sites
# where it does not, and it is transcribed byte-for-byte from what the dashboard
# had already written for fizzy and gitea-mirror.
#
# That verbatim part matters more than it looks. manage-websites.yaml is
# create-only for the SITE but rewrites the location block from the template on
# every run, so bringing a hand-made site under management means this file
# becomes what it serves. A tidier block here would be a silent behaviour change
# on the next unrelated run.
#
# Both current users proxy to a container published on this box's loopback, so
# there is no upstream TLS and no SNI to get right - see proxy-openclaw.conf.j2
# for the variant that has both.
location ^~ / {
    proxy_pass {{ item.upstream }};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header REMOTE-HOST $remote_addr;
    # WebSocket upgrade. Both current users need it - fizzy is Rails/Turbo and
    # gitea-mirror streams job progress - and it is in the stock block anyway.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $http_connection;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_http_version 1.1;
    add_header X-Cache $upstream_cache_status;
    proxy_ssl_server_name off;
    proxy_ssl_name $proxy_host;
}
