{{ ansible_managed | comment }}
# Managed by live/ansible/playbooks/gha-cache/install-gha-cache.yaml
# Rewritten in full on every run - edits made in the 1Panel dashboard are lost.
#
# 1Panel stores this at /opt/1panel/docker/compose/gha-cache/docker-compose.yml
# with the .env beside it. Both are written by the panel, not by Ansible over
# SSH, so the panel's own Compose page stays authoritative for start/stop/logs.
#
# Every secret is referenced as ${...} and lives in that .env, so the compose
# detail page the dashboard renders carries no credentials.
#
# One service and no volumes: cache payloads go to RustFS over S3, and the index
# goes to the PostgreSQL app install this stack joins 1panel-network to reach.
services:
  {{ gha_cache_container_name }}:
    image: ghcr.io/falcondev-oss/github-actions-cache-server:{{ gha_cache_version }}
    container_name: {{ gha_cache_container_name }}
    restart: always

    # Loopback only - see gha_cache_bind_address in vars/main.yaml. This is what
    # OpenResty proxies to; OpenResty runs with network_mode: host, so it cannot
    # reach the container across the bridge below and needs the published port.
    ports:
      - "{{ gha_cache_bind_address }}:{{ gha_cache_port }}:3000"

    # Declared explicitly, which also means Compose does NOT additionally create
    # and attach this project's `default` network - there is nothing else in the
    # stack to talk to. Outbound still works: this is a NAT bridge, so egress to
    # token.actions.githubusercontent.com and to the RustFS website leaves
    # through the host as usual.
    networks:
      - {{ gha_cache_network }}

    environment:
      # The URL the RUNNER will be told to connect to, not the one this
      # container listens on. It goes back in the Twirp CreateCacheEntry
      # response as `signed_upload_url` and in GetCacheEntryDownloadURL as the
      # download URL. See the long note in vars/main.yaml.
      API_BASE_URL: "{{ gha_cache_api_base_url }}"

      # The issuer whose JWKS every runner token is verified against, and
      # therefore what keeps one repository's cache out of another's. Not
      # decoration - see vars/main.yaml.
      #
      # SKIP_TOKEN_VALIDATION IS NOT SET HERE AND MUST NOT BE ADDED, not even
      # briefly while debugging a 401. It turns signature verification into a
      # bare decode and logs one warning; anything that can reach this server
      # could then claim any repository_id.
      ACTIONS_TOKEN_ISSUER: "{{ gha_cache_actions_token_issuer }}"

      # ===== Storage: S3 on RustFS =====
      STORAGE_DRIVER: s3
      STORAGE_S3_BUCKET: "{{ gha_cache_s3_bucket }}"
      STORAGE_S3_SOCKET_TIMEOUT_MS: "{{ gha_cache_s3_socket_timeout_ms }}"

      # There is no STORAGE_S3_ENDPOINT. lib/storage.ts builds its S3Client with
      # no `endpoint` key, so the AWS SDK's own resolution decides where the
      # requests go, and AWS_ENDPOINT_URL is the override this project declares
      # and tests. Omit it and the SDK resolves the real Amazon endpoint for
      # AWS_REGION - quietly, with no error until a request fails to sign.
      #
      # An https:// name rather than the RustFS guest's address, on purpose: it
      # is an Unbound alias onto this very host, so the request goes back out
      # through OpenResty, which terminates TLS with the wildcard and proxies on
      # to rustfs-01. Nothing needs configuring for that certificate to verify -
      # Node uses its own compiled-in root set, not the image's.
      AWS_REGION: "{{ gha_cache_s3_region }}"
      AWS_ENDPOINT_URL: "{{ gha_cache_s3_endpoint }}"

      # From the stack's .env, which install-gha-cache.yaml writes from the
      # RustFS vault. These are RustFS's root credentials.
      AWS_ACCESS_KEY_ID: ${GHA_CACHE_S3_ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${GHA_CACHE_S3_SECRET_ACCESS_KEY}

      # ===== Retention =====
      # Object storage reports no capacity, so this explicit byte budget is the
      # ONLY thing bounding the cache - without it enforceStorageBudget() has
      # nothing to compare against and returns immediately.
      CACHE_MAX_SIZE_BYTES: "{{ gha_cache_max_size_bytes }}"
      CACHE_CLEANUP_OLDER_THAN_DAYS: "{{ gha_cache_cleanup_older_than_days }}"
      ENABLE_DIRECT_DOWNLOADS: "{{ gha_cache_enable_direct_downloads | lower }}"

      # ===== Database =====
      # 1Panel's own PostgreSQL app install, reached by container name over
      # 1panel-network. Discrete fields, not DB_POSTGRES_URL - the env schema
      # accepts one form or the other and rejects a mixture, and this keeps the
      # password out of a single pasteable string.
      #
      # The database and its user are created in the dashboard, not here; the
      # playbook preflights that the database exists before pushing this file.
      DB_DRIVER: postgres
      DB_POSTGRES_HOST: "{{ gha_cache_db_host }}"
      DB_POSTGRES_PORT: "{{ gha_cache_db_port }}"
      DB_POSTGRES_DATABASE: "{{ gha_cache_db_name }}"
      DB_POSTGRES_USER: "{{ gha_cache_db_user }}"
      DB_POSTGRES_PASSWORD: ${GHA_CACHE_DB_PASSWORD}

    healthcheck:
      # /health is a flat 200 from the HTTP layer - it says the process is
      # serving, not that S3 or Postgres are reachable. That is still the useful
      # probe, because a server that cannot reach its database exits rather than
      # serving unhealthily: lib/db.ts calls process.exit(1) when the migrations
      # fail. Alpine base, so wget is present.
      test: ["CMD-SHELL", "wget -q -O- http://localhost:3000/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

networks:
  # `external: true` means "attach to the network that already exists under this
  # name" - Compose will not create it, and refuses to start the stack if it is
  # missing rather than inventing a project-prefixed one of its own. The
  # playbook's preflight looks for it first so that refusal arrives as a
  # readable failure instead of a stack that exists and will not come up.
  {{ gha_cache_network }}:
    name: {{ gha_cache_network }}
    external: true
