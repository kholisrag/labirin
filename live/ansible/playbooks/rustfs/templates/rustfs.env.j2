{{ ansible_managed | comment }}
# Managed by live/ansible/playbooks/rustfs/install-rustfs.yaml
# Rewritten in full on every run - edits made on the box are lost.
#
# systemd EnvironmentFile syntax: KEY=VALUE, one per line, no `export`, and no
# shell expansion. Quotes are stripped by systemd, so they are only needed
# around values with spaces.

# --- Storage -----------------------------------------------------------------
# A single path here is what makes this a Single Node Single Disk deployment:
# no erasure coding, no parity, no healing. The ellipsis form
# ("/data/rustfs{0...3}") is what turns it into SNMD - and that is a rebuild,
# not a restart, because the layout is written at first format.
RUSTFS_VOLUMES="{{ rustfs_volumes }}"

# --- Listeners ---------------------------------------------------------------
# Both bound on all interfaces: the client is OpenResty on the 1Panel VM, not
# the loopback. TLS is terminated there.
RUSTFS_ADDRESS="{{ rustfs_address }}"
RUSTFS_CONSOLE_ENABLE={{ rustfs_console_enable | bool | lower }}
RUSTFS_CONSOLE_ADDRESS="{{ rustfs_console_address }}"

# --- Credentials -------------------------------------------------------------
# Read on every start, not just the first - rotating these is edit-vault,
# re-run, restart. Left unset RustFS boots as rustfsadmin/rustfsadmin;
# tasks/preflight.yaml refuses to let that happen.
RUSTFS_ACCESS_KEY={{ rustfs_access_key }}
RUSTFS_SECRET_KEY={{ rustfs_secret_key }}

# --- S3 semantics ------------------------------------------------------------
# Pinned so the SigV4 credential scope is predictable across clients that
# default differently when given no region.
RUSTFS_REGION={{ rustfs_region }}
{% if rustfs_server_domains | length > 0 %}
# Virtual-hosted-style addressing: <bucket>.{{ rustfs_server_domains }}
# Needs a wildcard certificate one level deeper than the estate wildcard.
RUSTFS_SERVER_DOMAINS={{ rustfs_server_domains }}
{% else %}
# RUSTFS_SERVER_DOMAINS intentionally unset - path-style addressing only.
# The estate wildcard matches one label, so
# <bucket>.{{ rustfs_s3_host }} would not verify. See vars/main.yaml.
{% endif %}

# --- Observability -----------------------------------------------------------
# With a log directory set, logs go to files there rather than to stdout, so
# `journalctl -u rustfs` shows startup and systemd messages only - the request
# log is in {{ rustfs_log_directory }}.
RUSTFS_OBS_LOGGER_LEVEL={{ rustfs_log_level }}
RUSTFS_OBS_LOG_DIRECTORY="{{ rustfs_log_directory }}/"
