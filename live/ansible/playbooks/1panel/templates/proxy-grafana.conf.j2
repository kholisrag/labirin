{{ ansible_managed | comment }}
# Managed by live/ansible/playbooks/1panel/manage-websites.yaml
# Rewritten in full on every run - edits made in the 1Panel dashboard are lost.
#
# The stack is live/ansible/playbooks/monitoring/. Grafana is published on this
# box's loopback only, so this block is the single way in.
location ^~ / {
    proxy_pass {{ item.upstream }};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header REMOTE-HOST $remote_addr;

    # LOAD-BEARING, not decoration. Grafana builds redirects and its own asset
    # URLs from the scheme it thinks it is serving; without this it sees plain
    # http from OpenResty and the login redirect drops the browser onto an
    # http:// URL that this vhost then bounces back to https, once per hop.
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;

    # Grafana Live - the websocket at /api/live/ws that carries dashboard
    # streaming and the "someone else edited this" notices. Without the upgrade
    # pair nginx answers the handshake with a 200 and the browser console fills
    # with reconnect attempts while the dashboards themselves look fine, which
    # is a long way to go to find a missing header.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $http_connection;
    proxy_http_version 1.1;

    # A range query over 90 days of TSDB is slow, and Grafana proxies it through
    # its own backend rather than the browser going direct - so the whole wait
    # happens on this connection. nginx's 60s default cuts off exactly the
    # queries a long retention exists to make possible.
    proxy_connect_timeout 30s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Dashboard panels stream their results. Buffering turns a progressive
    # render into a pause followed by everything at once.
    proxy_buffering off;

    proxy_ssl_server_name off;
    proxy_ssl_name $proxy_host;
}
